{% comment %} Spotify embed include for the navbar dropdown. {% endcomment %}

{%- if site.spotify and site.spotify.playlist_id -%}
  <div class="spotify-navbar-menu">
    <div class="spotify-navbar-menu__label">jukebox</div>
    <iframe
      src="https://open.spotify.com/embed/playlist/{{ site.spotify.playlist_id }}"
      width="100%"
      height="{{ site.spotify.height | default: 152 }}"
      frameborder="0"
      allowtransparency="true"
      allow="encrypted-media"
    ></iframe>
  </div>
{%- endif -%}
