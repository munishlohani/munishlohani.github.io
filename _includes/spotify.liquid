{% comment %} Spotify navbar preview. {% endcomment %}

{%- if site.data.spotify and site.data.spotify.embeds and site.data.spotify.embeds.size > 0 -%}
  <div class="spotify-navbar-item">
    <button
      class="spotify-navbar-trigger"
      type="button"
      aria-label="Open Spotify jukebox"
      aria-expanded="false"
      title="Spotify jukebox"
    >
      <i class="fa-brands fa-spotify"></i>
      <span>jukebox</span>
    </button>
    <div class="spotify-navbar-preview" data-spotify-player data-spotify-embeds='{{ site.data.spotify.embeds | jsonify | escape }}'></div>
  </div>
{%- endif -%}
